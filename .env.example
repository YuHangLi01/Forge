# =========================================================
# Forge — 环境变量配置
# 复制为 .env 并填入真实值，不要提交 .env 到版本控制
#
# 标注说明：
#   【必填】         — 留空则服务无法启动
#   【演示必填:步骤】 — 对应 DEMO 步骤必须填写，留空该步骤失败
#   【默认值已填】   — 已有合理默认值，通常不需要改
#   【可选】         — 留空则跳过对应功能，不影响核心流程
#
# 对比缺失字段：
#   comm -23 <(grep -oP '^\w+' .env.example | sort) <(grep -oP '^\w+' .env | sort)
# =========================================================


# =========================================================
# 一、飞书应用（基础通信，全部必填）
# =========================================================

# 【必填】飞书开发者后台 → 凭证与基础信息 → App ID
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 【必填】飞书开发者后台 → 凭证与基础信息 → App Secret
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【必填】飞书开发者后台 → 事件订阅 → Verification Token
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【必填】飞书开发者后台 → 事件订阅 → Encrypt Key（开启加密时必填）
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【默认值已填】飞书 OpenAPI 域名，正式环境不需要修改
FEISHU_DOMAIN=https://open.feishu.cn


# =========================================================
# 二、豆包 / 火山方舟 LLM（意图解析、内容生成，全部必填）
# =========================================================

# 【必填】火山方舟控制台 → API Key 管理 → 创建 API Key
DOUBAO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【默认值已填】火山方舟推理 API 地址，末尾不加 /v1
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 【必填】豆包 Pro 推理接入点 ID（用于意图解析/规划/结构生成等高质量任务）
# 火山方舟控制台 → 模型推理 → 在线推理 → 创建推理接入点
DOUBAO_MODEL_PRO=ep-20241230000000-xxxxx

# 【必填】豆包 Lite 推理接入点 ID（用于批量内容生成低成本任务，也是 Step 12 降级目标）
DOUBAO_MODEL_LITE=ep-20241230000000-yyyyy


# =========================================================
# 三、火山引擎语音识别 ASR（Step 1 语音输入）
# =========================================================

# 【演示必填:Step1】火山引擎控制台 → 语音技术 → 录音文件识别 → App ID
# （旧版控制台对应 X-Api-App-Key）
VOLC_ASR_APP_ID=xxxxxxxxxx

# 【演示必填:Step1】火山引擎 ASR Access Token
# （旧版控制台对应 X-Api-Access-Key）
VOLC_ASR_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【默认值已填】ASR Resource ID；v2.0 接入点用 volc.seedasr.auc
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc

# 【默认值已填】v1 遗留字段，v3 录音文件 API 不使用，保留兼容
VOLC_ASR_CLUSTER=volcengine_input_common


# =========================================================
# 四、Forge 公网地址（Step 1 语音输入）
# =========================================================

# 【演示必填:Step1】Forge 服务对公网可达的 Base URL，不带末尾 /
# 与飞书事件订阅回调地址同一域名，例如 https://forge.example.com
# 火山引擎 ASR v3 会主动从此地址拉取临时音频文件完成转写
FORGE_PUBLIC_URL=https://forge.example.com


# =========================================================
# 五、飞书日历（Step 1 日历上下文注入）
# =========================================================

# 【演示必填:Step1】飞书日历用户 OAuth Token（calendar:event:readonly scope）
# 获取步骤：
#   1. 飞书开放平台 → 权限管理 → 开启 calendar:event:readonly
#   2. OAuth 2.0 授权码流程获取 user_access_token
# 留空则跳过日历查询，Step 1 中不会显示"飞书日历查询"Tool Use 卡片
FEISHU_CALENDAR_USER_TOKEN=


# =========================================================
# 六、飞书知识库（Step 5 产物归档 + @mention 战报）
# =========================================================

# 【演示必填:Step5】飞书知识库 Space ID
# 飞书知识库 → 设置 → 空间信息 中获取
# 留空则跳过归档，战报卡片不含 Wiki 链接
FEISHU_WIKI_SPACE_ID=

# 【可选】归档父节点 Token（留空则归档到知识库根节点）
FEISHU_WIKI_PARENT_NODE_TOKEN=


# =========================================================
# 七、PostgreSQL（LangGraph Checkpointer，必填）
# =========================================================

# 【必填】异步驱动，供 FastAPI / LangGraph 使用
DATABASE_URL=postgresql+psycopg://forge:yourpassword@localhost:5432/forge

# 【必填】同步驱动，供 Alembic 数据库迁移使用
DATABASE_URL_SYNC=postgresql+psycopg://forge:yourpassword@localhost:5432/forge


# =========================================================
# 八、Redis（任务队列 + 幂等锁 + ASR 音频缓存，必填）
# =========================================================

# 【默认值已填】Celery broker/backend；幂等锁和 ASR 临时音频也存这里
REDIS_URL=redis://localhost:6379/0


# =========================================================
# 九、ChromaDB（RAG 历史检索，Step 2/11 必需）
# =========================================================

# 【默认值已填】
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_TENANT=default_tenant
CHROMA_COLLECTION_NAME=forge_kb


# =========================================================
# 十、Embedding 模型（RAG 向量化）
# =========================================================

# 【默认值已填】bge-base-zh-v1.5 本地缓存目录（首次运行自动下载，约 210 MB）
MODEL_CACHE_DIR=~/.cache/forge/models


# =========================================================
# 十一、LangSmith 链路追踪（可选）
# =========================================================

# 【可选】留空则关闭 tracing
LANGSMITH_API_KEY=
# 【默认值已填】
LANGSMITH_PROJECT=forge-dev
# 【默认值已填】false = 关闭 tracing
LANGSMITH_TRACING=false
# 【默认值已填】隐藏节点输入/输出（PII 保护），生产环境建议 true
LANGSMITH_HIDE_INPUTS=true


# =========================================================
# 十二、功能开关
# =========================================================

# 【默认值已填】true = 走 LangGraph pipeline（演示必须为 true）
FORGE_USE_GRAPH=true

# 【默认值已填】3 = doc + ppt 全链路（演示必须为 3）
FORGE_STAGE=3


# =========================================================
# 十三、应用运行配置
# =========================================================

# 【默认值已填】
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000


# =========================================================
# 十四、Celery Worker 配置
# =========================================================

# 【默认值已填】任务硬超时（秒），doc+ppt 全链路约需 2 分钟
CELERY_TASK_TIME_LIMIT=360
# 【默认值已填】任务软超时（秒），触发后 Worker 可做清理
CELERY_TASK_SOFT_TIME_LIMIT=300
# 【默认值已填】Worker 并发数
CELERY_WORKER_CONCURRENCY=4


# =========================================================
# 十五、Docker Compose（仅本地开发用）
# =========================================================

POSTGRES_PASSWORD=yourpassword
