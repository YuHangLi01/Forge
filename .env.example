# =========================================================
# Forge — 环境变量示例
# 复制为 .env 并填入真实值，不要提交 .env 到版本控制
# 对比缺失字段：comm -23 <(grep -oP '^\w+' .env.example | sort) <(grep -oP '^\w+' .env | sort)
# =========================================================

# ---- 飞书应用配置 ----------------------------------------
# 飞书开发者后台 → 应用信息 → App ID
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# 飞书开发者后台 → 应用信息 → App Secret
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书事件订阅 → Verification Token
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书事件订阅 → Encrypt Key（开启加密时填写）
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书 OpenAPI 域名，默认不需要修改
FEISHU_DOMAIN=https://open.feishu.cn

# ---- 豆包 / 火山方舟 LLM ---------------------------------
# 火山方舟控制台 → API Key
DOUBAO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 火山方舟 API 地址，末尾不要加 /v1
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 豆包 Pro 推理接入点 ID（ep-xxx 格式，用于意图解析/规划等高质量任务）
DOUBAO_MODEL_PRO=ep-20241230000000-xxxxx
# 豆包 Lite 推理接入点 ID（用于内容生成等低成本任务）
DOUBAO_MODEL_LITE=ep-20241230000000-yyyyy

# ---- 火山引擎语音识别 ASR（录音文件转写 v3）--------------
# 火山引擎控制台 → 语音技术 → App ID（旧版控制台 X-Api-App-Key）
VOLC_ASR_APP_ID=xxxxxxxxxx
# 火山引擎 ASR Access Token（旧版控制台 X-Api-Access-Key）
VOLC_ASR_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ASR Resource ID；v2.0 用 volc.seedasr.auc，v1.0 用 volc.bigasr.auc
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc
# ASR 集群 ID（v1 遗留字段，v3 不使用，保留兼容）
VOLC_ASR_CLUSTER=volcengine_input_common

# ---- PostgreSQL -----------------------------------------
# 异步驱动，供 FastAPI / LangGraph Checkpointer 使用
DATABASE_URL=postgresql+psycopg://forge:yourpassword@localhost:5432/forge
# 同步驱动，供 Alembic 迁移使用
DATABASE_URL_SYNC=postgresql+psycopg://forge:yourpassword@localhost:5432/forge

# ---- Redis ----------------------------------------------
# Celery broker 与 result backend；也用于进度卡片节流和 active_task 取消
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB -------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_TENANT=default_tenant
CHROMA_COLLECTION_NAME=forge_kb

# ---- Embedding 模型缓存 ----------------------------------
# bge-base-zh-v1.5 模型本地缓存目录（首次运行自动下载，~210 MB）
MODEL_CACHE_DIR=~/.cache/forge/models

# ---- LangSmith 链路追踪（可选）--------------------------
# 留空或不填则关闭 tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=forge-dev
LANGSMITH_TRACING=false
# true 时隐藏节点输入/输出（PII 保护），建议生产环境开启
LANGSMITH_HIDE_INPUTS=true

# ---- 功能开关 --------------------------------------------
# true = 消息走 LangGraph pipeline；false = 走 Stage 1 旧路径
FORGE_USE_GRAPH=true
# 2 = 仅 doc pipeline；3 = doc + ppt pipeline
FORGE_STAGE=3

# ---- Forge 公网地址 --------------------------------------
# Forge 服务对公网可达的 Base URL（不带末尾 /），例如 https://forge.example.com
# 火山引擎 ASR v3 录音文件转写需要从此地址拉取临时音频文件，必须填写
FORGE_PUBLIC_URL=https://forge.example.com

# ---- 飞书日历（可选）------------------------------------
# 需要 calendar:event:readonly scope 的用户 OAuth Token
# 获取：飞书开放平台 → 权限管理 → 开启 calendar:event:readonly → OAuth 2.0 授权码流程
# 留空则跳过日历上下文注入
FEISHU_CALENDAR_USER_TOKEN=

# ---- 飞书知识库归档（可选）------------------------------
# 飞书知识库 Space ID，任务产物归档目标（留空则跳过归档）
FEISHU_WIKI_SPACE_ID=
# 归档父节点 Token（留空则挂根节点）
FEISHU_WIKI_PARENT_NODE_TOKEN=

# ---- 应用配置 --------------------------------------------
# 运行环境: dev | staging | prod
APP_ENV=dev
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Celery 配置 -----------------------------------------
CELERY_TASK_TIME_LIMIT=180
CELERY_TASK_SOFT_TIME_LIMIT=150
CELERY_WORKER_CONCURRENCY=4

# ---- Docker Compose（仅本地开发用）----------------------
POSTGRES_PASSWORD=yourpassword
